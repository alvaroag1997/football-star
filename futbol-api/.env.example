# Supabase → Project Settings → Database → Connection string → Transaction pooler (puerto 6543)
DATABASE_URL=postgresql://postgres.xxxx:CONTRASEÑA@aws-0-eu-west-1.pooler.supabase.com:6543/postgres

# Mismo valor que pones en supabase/03_cron.sql
CRON_SECRET=una-cadena-larga-y-aleatoria

# v1.3 · Supabase → Project Settings → API (la clave "anon / public", NUNCA la service_role)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Opcional: zona horaria de los mensajes automáticos del chat
APP_TIMEZONE=Europe/Madrid
